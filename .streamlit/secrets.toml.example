# Copy this file to .streamlit/secrets.toml and fill in the service_role key.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# NEVER commit secrets.toml — it is in .gitignore. The service_role key
# bypasses RLS entirely; the anon key cannot be used because all RLS
# policies are SELECT-only (it cannot write).

[supabase]
url = "https://neomyduxgyrzyjzyhxxf.supabase.co"
service_role_key = "PASTE_YOUR_SERVICE_ROLE_KEY_HERE"

# Shared login password for the app. Anyone opening the app must enter this
# before they can import anything. Pick something long; the app refuses to
# run while the placeholder is still here.
[auth]
password = "CHOOSE_A_LOGIN_PASSWORD"
