# Copy this file to .env (same folder) and fill it in. .env is gitignored: the key never reaches the app or the repo.

# ── The assistant's model: OpenAI ──
OPENAI_API_KEY=sk-...
# Needs tool calling and structured outputs. gpt-4.1 is the safe default; gpt-5 works too (slower, better).
OPENAI_MODEL=gpt-4.1

# ── Optional: Claude instead of OpenAI (the config accepts it; /ask needs OpenAI for now) ──
# REPORT_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5

# ── Server ──
PORT=8787
# Set this when the server is reachable beyond your laptop (a tunnel URL). The app sends it with every call.
ACCESS_CODE=
# Extra browser origins allowed to call this server, comma-separated. localhost, private-LAN addresses
# and https://naz712.github.io are always allowed.
ALLOW_ORIGINS=

# ── The production import ──
# Needed to upload the monthly CSV (npm run import) and to list the individual links (npm run links).
ADMIN_CODE=
# Optional: the secret each FA's link key is made from. Defaults to ACCESS_CODE; changing it invalidates every link.
LINK_SECRET=
# Where the app lives: each FA's link is this address plus their fc and key.
APP_URL=https://naz712.github.io/Luckyfinexis/
# Optional: where the uploaded CSV is kept between restarts. Default ./data/production.csv (gitignored); on Render, a disk path.
IMPORT_FILE=
