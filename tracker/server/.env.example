# Copy this file to .env (same folder) and fill it in. .env is gitignored: the keys never reach the app or the repo.

# ── Recap audio → text: Valsea (speaks the OpenAI speech-to-text shape) ──
VALSEA_API_KEY=
# Base URL from the Valsea dashboard/docs. The server posts the audio to {VALSEA_BASE_URL}/audio/transcriptions.
VALSEA_BASE_URL=https://api.valsea.ai/v1
# Their model name; blank means valsea-transcribe (from their docs).
VALSEA_MODEL=
# Blank (or auto) lets Valsea detect the language, which suits recaps that mix English, Mandarin and Malay.
# Set it to a word the way their docs show it (english) to pin one language.
VALSEA_LANGUAGE=
# Only if Valsea's endpoint path differs from /v1/audio/transcriptions: the full URL to post to.
VALSEA_TRANSCRIBE_URL=
# Only if the Valsea docs ask for extra form fields, as JSON, e.g. {"response_format":"verbose_json"}
VALSEA_EXTRA=

# ── Photo, notes PDF and transcript → report, and card rework: OpenAI ──
OPENAI_API_KEY=sk-...
# Needs vision, PDF input and structured outputs. gpt-4.1 is the safe default; gpt-5 works too (slower, better).
OPENAI_MODEL=gpt-4.1
# If the Valsea lines above are blank, the recap is transcribed by OpenAI with this model instead (whisper-1 also works).
TRANSCRIBE_MODEL=gpt-4o-transcribe
# Two-letter language code for OpenAI's transcriber (en). Blank lets it detect.
TRANSCRIBE_LANGUAGE=

# ── Optional: write the report with Claude instead of OpenAI ──
# REPORT_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5

# ── Server ──
PORT=8787
# Set this when the server is reachable beyond your laptop (a tunnel URL). The app sends it with every call.
ACCESS_CODE=
# Extra browser origins allowed to call this server, comma-separated. localhost, private-LAN addresses
# and https://naz712.github.io are always allowed.
ALLOW_ORIGINS=
